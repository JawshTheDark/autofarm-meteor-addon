{
  "id": "autofarm",
  "name": "AutoFarm Addon",
  "description": "Automatically farms fully grown crops and replants them.",
  "authors": [ "Jawsh" ],

  "schemaVersion": 1,
  "version": "${version}",
  "contact": {
    "sources": "https://github.com/MeteorDevelopment/meteor-addon-template"
  },
  "icon": "assets/template/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.jawsh.autofarm.AutoFarmAddon"
    ]
  },
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${mc_version}", "1.21.9"],
    "meteor-client": "*"
  }
}
